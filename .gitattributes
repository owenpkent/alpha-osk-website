# Git converts nothing by default, so whatever an editor happens to write is
# what gets committed. That is how scripts/alphaosk.js, the one LF file in the
# repo, arrived as CRLF in a commit that changed about thirty lines and recorded
# 279 deletions and 279 insertions: the diff was unreadable and blame for the
# whole file moved onto that commit. text=auto stores LF in the repository
# whatever the working tree holds, so an editor's default cannot do it again.
* text=auto

# Generated by tools/gen_demo_data.py. Normalised like everything else, but a
# diff should not pretend to be useful about 8000 words on one line.
scripts/demo-data.js linguist-generated=true

# Never convert these.
*.png binary
*.ico binary
*.jpg binary
*.woff binary
*.woff2 binary
